const RANKS = [
  [0,"مبتدئ"],[200,"طالب نحو"],[600,"قارئ"],[1400,"نحوي"],[3000,"بليغ"],[6000,"نحوي بارع"]
];
const BADGES = [
  {id:"start",icon:"🌱",name:"البداية",desc:"أول نشاط في التطبيق"},
  {id:"k20",icon:"📖",name:"عشرون بطاقة",desc:"حفظت ٢٠ بطاقة"},
  {id:"k60",icon:"📚",name:"ستون بطاقة",desc:"حفظت ٦٠ بطاقة"},
  {id:"q3",icon:"⭐",name:"أول نجمة",desc:"حققت ٣ نجوم في باب"},
  {id:"q3x5",icon:"🌟",name:"خمسة أبواب",desc:"ثلاث نجوم في ٥ أبواب"},
  {id:"c10",icon:"🔥",name:"سلسلة اشتعال",desc:"١٠ إجابات صحيحة متتالية"},
  {id:"all",icon:"🏆",name:"أتقنتَ الكل",desc:"نجمة واحدة على الأقل في كل الأبواب"},
  {id:"d3",icon:"📅",name:"مداومة",desc:"تدربتَ في ثلاثة أيام"},
];

function rankOf(xp) {
  let r = RANKS[0], nx = null;
  RANKS.forEach((k,i)=>{ if(xp>=k[0]){r=k; nx=RANKS[i+1]||null;} });
  return {r,nx};
}
function starsOf(id) {
  const b = S.best[id] || 0;
  return b>=100?3 : b>=75?2 : b>=50?1 : 0;
}
function totalStars() {
  return CHAPTERS.reduce((a,c)=>a+starsOf(c.id),0);
}
function knownCount() { return Object.keys(S.known).length; }
function esc(s){ return String(s).replace(/[&<>"]/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;"}[c])); }
function shuffle(a){ a=[...a]; for(let i=a.length-1;i>0;i--){const j=0|Math.random()*(i+1);[a[i],a[j]]=[a[j],a[i]];} return a; }

function gainXP(n) {
  const br = rankOf(S.xp).r[1];
  S.xp += n;
  S.days[new Date().toDateString()] = 1;
  saveState();
  renderTopbar();
  const ar = rankOf(S.xp).r[1];
  if(ar !== br) showToast(`🎉 لقبٌ جديد: ${ar}`);
  checkBadges();
}
function checkBadges() {
  const g = (id,cond) => {
    if(cond && !S.badges[id]) {
      S.badges[id]=1; saveState();
      const b = BADGES.find(x=>x.id===id);
      if(b) showToast(`${b.icon} وسامٌ جديد: ${b.name}`);
    }
  };
  const kn = knownCount(), s3 = CHAPTERS.filter(c=>starsOf(c.id)===3).length;
  const allOne = CHAPTERS.every(c=>starsOf(c.id)>=1);
  g("start", S.xp>0);
  g("k20", kn>=20);
  g("k60", kn>=60);
  g("q3", s3>=1);
  g("q3x5", s3>=5);
  g("c10", S.maxCombo>=10);
  g("all", allOne);
  g("d3", Object.keys(S.days).length>=3);
}

function showToast(msg) {
  const t = document.getElementById("toast");
  t.innerHTML = msg;
  t.classList.add("show");
  clearTimeout(t._t);
  t._t = setTimeout(()=>t.classList.remove("show"), 2800);
}

