<!doctype html><html><head><meta charset=utf8><meta name=viewport content="width=device-width,initial-scale=1"><style>:root{color-scheme:light}body{margin:0;padding:0;font:14px -apple-system,BlinkMacSystemFont,sans-serif;background:#fff;color:#000}img{max-width:100%}[hidden]:not([hidden=until-found i]){display:none!important}</style></head><body>
<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Nahwu — Al Jumlah Al Fi'liyah</title>
<style>
/* ─── Design tokens ─── */
:root {
  --bg: #f8f9fb;
  --surface: #ffffff;
  --surface2: #f1f3f7;
  --border: #e4e8ef;
  --ink: #1a2236;
  --ink2: #4a5568;
  --ink3: #8896a8;
  --accent: #2563eb;
  --accent-soft: #eff6ff;
  --accent2: #0ea5e9;
  --green: #16a34a;
  --green-soft: #f0fdf4;
  --red: #dc2626;
  --red-soft: #fef2f2;
  --amber: #d97706;
  --amber-soft: #fffbeb;
  --purple: #7c3aed;
  --purple-soft: #f5f3ff;
  --shadow-sm: 0 1px 3px rgba(0,0,0,.06), 0 1px 2px rgba(0,0,0,.04);
  --shadow: 0 4px 12px rgba(0,0,0,.08), 0 2px 4px rgba(0,0,0,.04);
  --shadow-lg: 0 12px 32px rgba(0,0,0,.10), 0 4px 8px rgba(0,0,0,.06);
  --radius: 14px;
  --radius-sm: 8px;
  --radius-lg: 20px;
  --font-ar: "Segoe UI", "Noto Sans Arabic", "Arabic Typesetting", "Traditional Arabic", system-ui, sans-serif;
  --font-ui: "Inter", "Segoe UI", system-ui, sans-serif;
  --transition: .18s cubic-bezier(.4,0,.2,1);
}
@media (prefers-color-scheme: dark) {
  :root:not([data-theme="light"]) {
    --bg: #0f1117; --surface: #1a1f2e; --surface2: #232838;
    --border: #2d3448; --ink: #f0f4ff; --ink2: #9ba8bf; --ink3: #5a6480;
    --accent: #3b82f6; --accent-soft: #1e2d4a;
    --green: #22c55e; --green-soft: #0f2a1a;
    --red: #ef4444; --red-soft: #2a1010;
    --amber: #f59e0b; --amber-soft: #2a1f07;
    --purple: #a78bfa; --purple-soft: #1e1630;
    --shadow-sm: 0 1px 3px rgba(0,0,0,.3); --shadow: 0 4px 12px rgba(0,0,0,.35);
    --shadow-lg: 0 12px 32px rgba(0,0,0,.4);
  }
}
:root[data-theme="dark"] {
  --bg: #0f1117; --surface: #1a1f2e; --surface2: #232838;
  --border: #2d3448; --ink: #f0f4ff; --ink2: #9ba8bf; --ink3: #5a6480;
  --accent: #3b82f6; --accent-soft: #1e2d4a;
  --green: #22c55e; --green-soft: #0f2a1a;
  --red: #ef4444; --red-soft: #2a1010;
  --amber: #f59e0b; --amber-soft: #2a1f07;
  --purple: #a78bfa; --purple-soft: #1e1630;
  --shadow-sm: 0 1px 3px rgba(0,0,0,.3); --shadow: 0 4px 12px rgba(0,0,0,.35);
  --shadow-lg: 0 12px 32px rgba(0,0,0,.4);
}

/* ─── Reset & base ─── */
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{font-family:var(--font-ui);background:var(--bg);color:var(--ink);min-height:100vh;-webkit-font-smoothing:antialiased}
button{font:inherit;cursor:pointer;border:none;background:none;color:inherit}
input,select,textarea{font:inherit;color:inherit;background:none;border:none;outline:none}
a{color:inherit;text-decoration:none}
svg{display:block;flex-shrink:0}

/* ─── Scrollbar ─── */
::-webkit-scrollbar{width:6px;height:6px}
::-webkit-scrollbar-track{background:transparent}
::-webkit-scrollbar-thumb{background:var(--border);border-radius:99px}

/* ─── Layout ─── */
#app{display:flex;flex-direction:column;min-height:100vh}
.topbar{position:sticky;top:0;z-index:100;background:rgba(248,249,251,.85);backdrop-filter:blur(16px);-webkit-backdrop-filter:blur(16px);border-bottom:1px solid var(--border);padding:0 24px;height:60px;display:flex;align-items:center;gap:16px}
@media(prefers-color-scheme:dark){.topbar{background:rgba(15,17,23,.85)}}
[data-theme=dark] .topbar{background:rgba(15,17,23,.85)}
.topbar-brand{display:flex;align-items:center;gap:10px;flex:1}
.topbar-logo{width:32px;height:32px;background:var(--accent);border-radius:9px;display:flex;align-items:center;justify-content:center;color:#fff;font-weight:800;font-size:13px}
.topbar-title{font-weight:700;font-size:15px;line-height:1.2}
.topbar-sub{font-size:11px;color:var(--ink3);line-height:1}
.topbar-actions{display:flex;align-items:center;gap:8px}
.icon-btn{width:36px;height:36px;border-radius:9px;display:flex;align-items:center;justify-content:center;color:var(--ink2);transition:var(--transition);background:var(--surface2);border:1px solid var(--border)}
.icon-btn:hover{background:var(--accent-soft);color:var(--accent);border-color:var(--accent)}

/* XP bar */
.xp-strip{height:3px;background:var(--border);border-radius:0}
.xp-fill{height:100%;background:linear-gradient(90deg,var(--accent),var(--accent2));border-radius:99px;transition:width .6s cubic-bezier(.4,0,.2,1)}
.main{flex:1;max-width:1100px;width:100%;margin:0 auto;padding:24px 20px 80px}

/* ─── Cards & containers ─── */
.card{background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);box-shadow:var(--shadow-sm)}
.card-lg{border-radius:var(--radius-lg);box-shadow:var(--shadow)}

/* ─── Hero / Stats bar ─── */
.hero{background:var(--surface);border:1px solid var(--border);border-radius:var(--radius-lg);padding:24px 28px;margin-bottom:24px;display:flex;flex-wrap:wrap;gap:20px;align-items:center;box-shadow:var(--shadow-sm)}
.hero-text h1{font-size:20px;font-weight:800;color:var(--ink);margin-bottom:4px}
.hero-text p{font-size:13px;color:var(--ink2)}
.hero-stats{display:flex;gap:16px;flex-wrap:wrap;margin-right:auto}
.stat-box{text-align:center;padding:10px 16px;background:var(--surface2);border-radius:var(--radius-sm);border:1px solid var(--border);min-width:72px}
.stat-box .val{font-size:20px;font-weight:800;color:var(--accent);font-family:var(--font-ui)}
.stat-box .lbl{font-size:10px;color:var(--ink3);text-transform:uppercase;letter-spacing:.05em;margin-top:2px}
.xp-info{display:flex;flex-direction:column;gap:6px;min-width:160px}
.xp-label{display:flex;justify-content:space-between;font-size:11px;color:var(--ink3)}
.xp-bar-wrap{height:6px;background:var(--surface2);border-radius:99px;overflow:hidden}
.xp-bar-inner{height:100%;background:linear-gradient(90deg,var(--accent),var(--accent2));border-radius:99px;transition:width .6s}

/* ─── Chapter grid ─── */
.section-title{font-size:13px;font-weight:700;color:var(--ink3);text-transform:uppercase;letter-spacing:.06em;margin-bottom:14px;display:flex;align-items:center;gap:8px}
.section-title::before{content:'';width:3px;height:14px;background:var(--accent);border-radius:2px;display:block}
.chapters-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:12px;margin-bottom:32px}
.chapter-card{background:var(--surface);border:1px solid var(--border);border-radius:var(--radius);padding:16px 18px;cursor:pointer;transition:var(--transition);position:relative;overflow:hidden;display:flex;flex-direction:column;gap:8px}
.chapter-card::before{content:'';position:absolute;inset:0;opacity:0;background:linear-gradient(135deg,var(--accent-soft) 0%,transparent 70%);transition:opacity var(--transition)}
.chapter-card:hover{border-color:var(--accent);box-shadow:var(--shadow);transform:translateY(-2px)}
.chapter-card:hover::before{opacity:1}
.chapter-card .ch-num{font-size:10px;font-weight:700;color:var(--accent);text-transform:uppercase;letter-spacing:.06em}
.chapter-card .ch-title{font-family:var(--font-ar);font-size:16px;font-weight:700;color:var(--ink);line-height:1.5;direction:rtl}
.chapter-card .ch-sub{font-size:11px;color:var(--ink3);direction:rtl;font-family:var(--font-ar);line-height:1.5}
.chapter-card .ch-meta{display:flex;align-items:center;justify-content:space-between;margin-top:4px}
.chapter-card .ch-count{font-size:11px;color:var(--ink3);background:var(--surface2);padding:2px 8px;border-radius:99px;border:1px solid var(--border)}
.chapter-card .ch-stars{display:flex;gap:2px}
.chapter-card .ch-stars span{width:10px;height:10px;border-radius:50%;background:var(--border);display:block}
.chapter-card .ch-stars span.on{background:var(--amber)}
.chapter-card .ch-prog{height:3px;background:var(--surface2);border-radius:99px;overflow:hidden;margin-top:6px}
.chapter-card .ch-prog-fill{height:100%;background:var(--green);border-radius:99px;transition:width .4s}

/* ─── Chapter detail ─── */
.chapter-header{display:flex;align-items:flex-start;gap:14px;margin-bottom:20px}
.back-btn{display:flex;align-items:center;gap:6px;font-size:13px;color:var(--ink2);background:var(--surface2);border:1px solid var(--border);border-radius:var(--radius-sm);padding:6px 12px;transition:var(--transition);flex-shrink:0;margin-top:3px}
.back-btn:hover{background:var(--accent-soft);color:var(--accent);border-color:var(--accent)}
.chapter-title-wrap{flex:1}
.chapter-title-wrap h2{font-family:var(--font-ar);font-size:22px;font-weight:800;direction:rtl;line-height:1.4}
.chapter-title-wrap .ch-badge{font-size:11px;color:var(--ink3);background:var(--surface2);border:1px solid var(--border);border-radius:99px;padding:2px 10px;display:inline-block;margin-top:4px}
.tab-row{display:flex;gap:6px;flex-wrap:wrap;margin-bottom:20px}
.tab-btn{display:flex;align-items:center;gap:6px;padding:7px 16px;border-radius:var(--radius-sm);font-size:13px;font-weight:600;color:var(--ink2);background:var(--surface2);border:1px solid var(--border);transition:var(--transition)}
.tab-btn:hover{color:var(--ink);border-color:var(--accent)}
.tab-btn.active{background:var(--accent);color:#fff;border-color:var(--accent);box-shadow:0 2px 8px rgba(37,99,235,.25)}
.tab-btn .tab-icon{font-size:15px}

/* ─── Panel ─── */
.panel{background:var(--surface);border:1px solid var(--border);border-radius:var(--radius-lg);padding:24px;box-shadow:var(--shadow-sm);min-height:300px}

/* ─── Flashcard ─── */
.fc-wrap{max-width:580px;margin:0 auto}
.fc-progress{display:flex;align-items:center;gap:12px;margin-bottom:16px}
.fc-progress .fp-label{font-size:12px;color:var(--ink3);font-variant-numeric:tabular-nums;white-space:nowrap}
.fc-progress .fp-bar{flex:1;height:4px;background:var(--surface2);border-radius:99px;overflow:hidden}
.fc-progress .fp-bar-fill{height:100%;background:var(--accent);border-radius:99px;transition:width .4s}
.card-scene{perspective:1400px;height:280px;margin-bottom:16px}
.card-inner{position:relative;width:100%;height:100%;transition:transform .55s cubic-bezier(.4,0,.2,1);transform-style:preserve-3d;cursor:pointer}
.card-inner.flipped{transform:rotateY(180deg)}
.card-face{position:absolute;inset:0;backface-visibility:hidden;border-radius:var(--radius-lg);border:1.5px solid var(--border);display:flex;flex-direction:column;align-items:center;justify-content:center;padding:28px;text-align:center;transition:border-color var(--transition)}
.card-face.front{background:var(--surface)}
.card-face.back{background:var(--accent-soft);border-color:var(--accent);transform:rotateY(180deg)}
.card-face .badge{font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.07em;color:var(--ink3);background:var(--surface2);border:1px solid var(--border);border-radius:99px;padding:3px 10px;margin-bottom:16px}
.card-face.back .badge{background:var(--accent);color:#fff;border-color:var(--accent)}
.card-face .card-term{font-family:var(--font-ar);font-size:26px;font-weight:800;color:var(--accent);direction:rtl;line-height:1.4;margin-bottom:8px}
.card-face .card-hint{font-size:12px;color:var(--ink3);margin-top:8px}
.card-face .card-def{font-family:var(--font-ar);font-size:16px;color:var(--ink);direction:rtl;line-height:1.7}
.card-face .card-example{font-family:var(--font-ar);font-size:14px;color:var(--ink2);direction:rtl;line-height:1.6;margin-top:12px;padding:10px 14px;background:var(--surface);border-radius:var(--radius-sm);border:1px solid var(--border);width:100%;text-align:right}
.fc-actions{display:flex;gap:10px;justify-content:center;flex-wrap:wrap}
.fc-btn{display:flex;align-items:center;gap:6px;padding:9px 20px;border-radius:var(--radius-sm);font-size:13px;font-weight:600;border:1.5px solid var(--border);background:var(--surface);transition:var(--transition)}
.fc-btn:hover{box-shadow:var(--shadow-sm);transform:translateY(-1px)}
.fc-btn.good{border-color:var(--green);color:var(--green);background:var(--green-soft)}
.fc-btn.bad{border-color:var(--red);color:var(--red);background:var(--red-soft)}
.fc-btn.flip{border-color:var(--accent);color:var(--accent);background:var(--accent-soft)}

/* ─── Quiz ─── */
.quiz-wrap{max-width:580px;margin:0 auto}
.quiz-meta{display:flex;align-items:center;gap:12px;margin-bottom:20px}
.quiz-meta .qm-prog{flex:1;height:4px;background:var(--surface2);border-radius:99px;overflow:hidden}
.quiz-meta .qm-fill{height:100%;background:var(--accent);border-radius:99px;transition:width .4s}
.quiz-meta .qm-score{font-size:12px;color:var(--ink3);font-variant-numeric:tabular-nums;display:flex;align-items:center;gap:8px}
.quiz-meta .qm-combo{font-size:11px;font-weight:700;color:var(--amber);background:var(--amber-soft);border-radius:99px;padding:2px 8px}
.quiz-type{font-size:11px;font-weight:600;text-transform:uppercase;letter-spacing:.07em;color:var(--ink3);background:var(--surface2);border:1px solid var(--border);border-radius:99px;padding:3px 10px;display:inline-block;margin-bottom:12px}
.quiz-q{font-family:var(--font-ar);font-size:20px;font-weight:700;color:var(--ink);direction:rtl;line-height:1.5;margin-bottom:6px;padding:16px 20px;background:var(--surface2);border-radius:var(--radius);border:1px solid var(--border)}
.quiz-q .qterm{display:block;font-size:26px;color:var(--accent);margin-bottom:4px}
.quiz-q .qdef{display:block;font-size:16px}
.opts{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:14px}
.opt-btn{border:1.5px solid var(--border);background:var(--surface);border-radius:var(--radius);padding:12px 16px;font-family:var(--font-ar);font-size:14px;color:var(--ink);direction:rtl;line-height:1.6;text-align:right;transition:var(--transition);cursor:pointer;position:relative}
.opt-btn:hover:not(:disabled){border-color:var(--accent);background:var(--accent-soft)}
.opt-btn.correct{border-color:var(--green)!important;background:var(--green-soft)!important;color:var(--green)}
.opt-btn.wrong{border-color:var(--red)!important;background:var(--red-soft)!important;color:var(--red)}
.opt-btn:disabled{cursor:default}
.quiz-fb{min-height:32px;text-align:center;font-size:14px;font-weight:600;margin-top:10px;transition:opacity var(--transition)}
.quiz-fb.ok{color:var(--green)}.quiz-fb.no{color:var(--red)}

/* ─── Review (list) ─── */
.review-search{display:flex;gap:8px;margin-bottom:14px}
.review-search input{flex:1;background:var(--surface2);border:1px solid var(--border);border-radius:var(--radius-sm);padding:8px 14px;font-size:14px;transition:border-color var(--transition);direction:rtl}
.review-search input:focus{border-color:var(--accent)}
.review-list{display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:10px}
.review-card{background:var(--surface2);border:1px solid var(--border);border-radius:var(--radius);padding:14px 16px;transition:var(--transition)}
.review-card:hover{border-color:var(--accent);box-shadow:var(--shadow-sm)}
.review-card .rc-term{font-family:var(--font-ar);font-size:17px;font-weight:700;color:var(--accent);direction:rtl;margin-bottom:6px}
.review-card .rc-def{font-family:var(--font-ar);font-size:13px;color:var(--ink2);direction:rtl;line-height:1.7}
.review-card .rc-ex{font-family:var(--font-ar);font-size:12px;color:var(--ink3);direction:rtl;margin-top:8px;padding-top:8px;border-top:1px solid var(--border);line-height:1.6}
.review-card .rc-tag{font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.05em;color:var(--purple);background:var(--purple-soft);border-radius:99px;padding:2px 8px;display:inline-block;margin-top:6px}
.review-card.known{border-right:3px solid var(--green)}

/* ─── Result ─── */
.result-wrap{text-align:center;padding:20px}
.result-stars{display:flex;gap:8px;justify-content:center;margin-bottom:16px}
.result-star{font-size:36px;filter:grayscale(1);opacity:.25;transition:all .4s}
.result-star.on{filter:none;opacity:1}
.result-score{font-size:42px;font-weight:900;color:var(--ink);font-variant-numeric:tabular-nums;margin-bottom:4px}
.result-sub{font-size:14px;color:var(--ink2);margin-bottom:20px}
.result-xp{font-size:13px;font-weight:700;color:var(--accent);background:var(--accent-soft);border-radius:99px;padding:4px 14px;display:inline-block;margin-bottom:20px}
.result-msg{font-size:15px;color:var(--ink2);margin-bottom:24px}
.result-actions{display:flex;gap:10px;justify-content:center;flex-wrap:wrap}
.r-btn{padding:10px 22px;border-radius:var(--radius-sm);font-size:14px;font-weight:600;transition:var(--transition);border:1.5px solid var(--border);background:var(--surface)}
.r-btn:hover{box-shadow:var(--shadow-sm);transform:translateY(-1px)}
.r-btn.primary{background:var(--accent);color:#fff;border-color:var(--accent)}
.r-btn.primary:hover{background:#1d4ed8}

/* ─── Badges overlay ─── */
.overlay{position:fixed;inset:0;background:rgba(0,0,0,.45);backdrop-filter:blur(6px);z-index:200;display:flex;align-items:center;justify-content:center;opacity:0;pointer-events:none;transition:opacity .25s}
.overlay.open{opacity:1;pointer-events:all}
.overlay-box{background:var(--surface);border:1px solid var(--border);border-radius:var(--radius-lg);padding:28px;width:min(560px,92vw);max-height:80vh;overflow-y:auto;box-shadow:var(--shadow-lg);transform:translateY(12px) scale(.97);transition:transform .25s;direction:rtl}
.overlay.open .overlay-box{transform:none}
.overlay-head{display:flex;align-items:center;gap:12px;margin-bottom:20px;direction:rtl}
.overlay-head h2{font-size:17px;font-weight:800;flex:1}
.close-btn{width:30px;height:30px;border-radius:50%;background:var(--surface2);display:flex;align-items:center;justify-content:center;font-size:18px;color:var(--ink2);transition:var(--transition)}
.close-btn:hover{background:var(--red-soft);color:var(--red)}
.badges-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(130px,1fr));gap:10px}
.badge-item{background:var(--surface2);border:1.5px solid var(--border);border-radius:var(--radius);padding:14px;text-align:center;transition:var(--transition)}
.badge-item.earned{border-color:var(--amber);box-shadow:0 0 0 1px var(--amber)}
.badge-item .bi-icon{font-size:28px;filter:grayscale(1);opacity:.3;display:block;margin-bottom:8px}
.badge-item.earned .bi-icon{filter:none;opacity:1}
.badge-item .bi-name{font-size:12px;font-weight:700;color:var(--ink);margin-bottom:2px}
.badge-item .bi-desc{font-size:10px;color:var(--ink3);line-height:1.4}
.rank-strip{background:var(--accent-soft);border:1.5px solid var(--accent);border-radius:var(--radius);padding:12px 16px;display:flex;align-items:center;gap:10px;margin-bottom:16px;direction:rtl}
.rank-strip .rs-rank{font-size:22px;font-weight:900;color:var(--accent);flex:1}
.rank-strip .rs-sub{font-size:11px;color:var(--ink2)}

/* ─── Toast ─── */
.toast{position:fixed;bottom:24px;left:50%;transform:translateX(-50%) translateY(80px);background:var(--ink);color:#fff;border-radius:var(--radius);padding:10px 20px;font-size:13px;font-weight:500;box-shadow:var(--shadow-lg);z-index:999;white-space:nowrap;transition:transform .3s cubic-bezier(.4,0,.2,1);max-width:90vw;white-space:normal;text-align:center}
.toast.show{transform:translateX(-50%)}

/* ─── Intro section ─── */
.intro-topics{display:flex;flex-direction:column;gap:8px}
.intro-topic{display:flex;align-items:flex-start;gap:10px;padding:10px 14px;background:var(--surface2);border:1px solid var(--border);border-radius:var(--radius-sm);direction:rtl;font-family:var(--font-ar);font-size:14px;color:var(--ink2);line-height:1.5}
.intro-topic .it-dot{width:6px;height:6px;border-radius:50%;background:var(--accent);flex-shrink:0;margin-top:6px}

/* ─── Empty state ─── */
.empty{text-align:center;padding:48px 20px;color:var(--ink3)}
.empty .em-icon{font-size:48px;margin-bottom:12px;opacity:.4}
.empty p{font-size:14px}

/* ─── Responsive ─── */
@media(max-width:640px){
  .topbar{padding:0 14px}.main{padding:16px 14px 72px}
  .hero{padding:16px 18px}.hero-stats{gap:10px}
  .chapters-grid{grid-template-columns:1fr 1fr}
  .opts{grid-template-columns:1fr}
  .panel{padding:16px}
  .card-face .card-term{font-size:22px}
  .result-score{font-size:36px}
  .topbar-sub{display:none}
}
