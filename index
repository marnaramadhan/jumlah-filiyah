const KEY = "nahwu-filiyah-v1";
let S;
function loadState() {
  try { S = JSON.parse(localStorage.getItem(KEY)) || {}; } catch { S = {}; }
  S.xp = S.xp || 0;
  S.known = S.known || {};
  S.best = S.best || {};
  S.badges = S.badges || {};
  S.days = S.days || {};
  S.maxCombo = S.maxCombo || 0;
  S.fastMatch = S.fastMatch || null;
  S.combo = 0;
}
function saveState() { try { localStorage.setItem(KEY, JSON.stringify(S)); } catch {} }
loadState();

