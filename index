    div.className = "chapter-card";
    div.innerHTML = `
      <div class="ch-num">Bab ${ch.id} · ${qLen} Soal</div>
      <div class="ch-title">${esc(ch.title)}</div>
      <div class="ch-sub">${esc(ch.sub)}</div>
      <div class="ch-meta">
        <span class="ch-count">${cLen} kartu · ✓${knCh}</span>
        <span class="ch-stars">${starHtml}</span>
      </div>
      <div class="ch-prog"><div class="ch-prog-fill" style="width:${pct2}%"></div></div>`;
    div.onclick = ()=>go({screen:"chapter",id:ch.id,tab:"flash"});
    grid.appendChild(div);
  });

  document.getElementById("resetBtn").onclick = ()=>{
    if(confirm("Yakin hapus semua progress?")){ try{localStorage.removeItem(KEY);}catch{} loadState(); go({screen:"home"}); }
  };
}

/* ── Chapter ── */
function renderChapter(id, tab) {
  const ch = CHAPTERS.find(c=>c.id===id);
  if(!ch) return go({screen:"home"});
  const app = document.getElementById("app");
  let main = document.getElementById("main-content");
  if(!main){ main=document.createElement("div"); main.id="main-content"; app.appendChild(main); }

  const tabs = [
    {id:"flash",icon:"🃏",label:"Flashcard",sub:"Hafalan"},
    {id:"quiz",icon:"🎯",label:"Kuis",sub:"10 Soal"},
    {id:"review",icon:"📋",label:"Materi",sub:"Daftar"},
  ];

  main.innerHTML = `
  <div class="main">
    <div class="chapter-header">
      <button class="back-btn" id="backBtn">← Kembali</button>
      <div class="chapter-title-wrap">
        <h2>${esc(ch.title)}</h2>
        <span class="ch-badge">Bab ${ch.id} · ${esc(ch.sub)}</span>
      </div>
    </div>
    <div class="tab-row">
      ${tabs.map(t=>`<button class="tab-btn${t.id===tab?' active':''}" data-tab="${t.id}">
        <span class="tab-icon">${t.icon}</span>${t.label}<small>${t.sub}</small>
      </button>`).join('')}
    </div>
    <div class="panel" id="panel"></div>
  </div>`;

  document.getElementById("backBtn").onclick = ()=>go({screen:"home"});
  document.querySelectorAll(".tab-btn").forEach(b=>{
    b.onclick = ()=>go({screen:"chapter",id,tab:b.dataset.tab});
  });

  const panel = document.getElementById("panel");
  if(tab==="flash") renderFlash(panel, ch);
  else if(tab==="quiz") renderQuiz(panel, ch);
  else renderReview(panel, ch);
}

/* ── Flashcard ── */
function renderFlash(panel, ch) {
  const deck = shuffle(ch.cards.map((c,i)=>({...c,idx:i})));
  let pos=0, knew=0, flipped=false;

  function show() {
    if(pos>=deck.length){
      panel.innerHTML = `
        <div class="result-wrap">
          <div class="result-score">${knew}/${deck.length}</div>
          <div class="result-sub">بطاقات تمَّت مراجعتها</div>
          <div class="result-xp">+${knew*2} XP</div>
          <div class="result-msg">${knew===deck.length?"ممتاز! أتقنت جميع البطاقات 🎉":knew>=deck.length*.7?"جيد جداً — كرِّر ما فاتك":"راجع البطاقات مرةً أخرى"}</div>
          <div class="result-actions">
            <button class="r-btn primary" id="rAgain">🔁 أعِد البطاقات</button>
            <button class="r-btn" id="rQuiz">🎯 ابدأ الكويز</button>
          </div>
        </div>`;
      document.getElementById("rAgain").onclick=()=>renderFlash(panel,ch);
      document.getElementById("rQuiz").onclick=()=>go({screen:"chapter",id:ch.id,tab:"quiz"});
      return;
    }
    const e=deck[pos];
    const isKnown = !!S.known[ch.id+"-"+e.idx];
    panel.innerHTML = `
      <div class="fc-wrap">
        <div class="fc-progress">
          <span class="fp-label">${pos+1} / ${deck.length}</span>
          <div class="fp-bar"><div class="fp-bar-fill" style="width:${pos/deck.length*100}%"></div></div>
          <span class="fp-label">✓ ${knew}</span>
        </div>
        <div class="card-scene" id="scene">
          <div class="card-inner" id="cardInner">
            <div class="card-face front">
              <div class="badge">المصطلح — Istilah</div>
              <div class="card-term">${esc(e.term)}</div>
              <div class="card-hint">⬇ Klik kartu untuk melihat definisi</div>
            </div>
            <div class="card-face back">
              <div class="badge">التعريف — Definisi</div>
              <div class="card-def">${esc(e.def)}</div>
              ${e.ex?`<div class="card-example">📝 ${esc(e.ex)}</div>`:''}
            </div>
          </div>
        </div>
        <div class="fc-actions" id="fcActs" style="visibility:hidden">
          <button class="fc-btn good" id="fcGood">✓ Hafal</button>
          <button class="fc-btn bad" id="fcBad">↺ Belum hafal</button>
        </div>
        <div style="text-align:center;margin-top:8px">
          <button class="fc-btn flip" id="fcFlip">↕ Balik kartu</button>
        </div>
      </div>`;
    flipped=false;
    const inner=document.getElementById("cardInner");
    const acts=document.getElementById("fcActs");
    const doFlip=()=>{ flipped=!flipped; inner.classList.toggle("flipped",flipped); acts.style.visibility="visible"; };
    inner.onclick=doFlip;
    document.getElementById("fcFlip").onclick=doFlip;
    document.getElementById("fcGood").onclick=()=>{
      if(!S.known[ch.id+"-"+e.idx]){ S.known[ch.id+"-"+e.idx]=1; gainXP(2); }
      knew++; pos++; show();
    };
    document.getElementById("fcBad").onclick=()=>{ deck.push(e); pos++; show(); };
  }
  show();
}

/* ── Quiz ── */
function renderQuiz(panel, ch) {
  const pool = shuffle(ch.quiz).slice(0,Math.min(10,ch.quiz.length));
  let pos=0, right=0, combo=0, earned=0;

  if(!pool.length){ panel.innerHTML='<div class="empty"><div class="em-icon">📭</div><p>Tidak ada soal untuk bab ini.</p></div>'; return; }

  function ask() {
    if(pos>=pool.length) return done();
    const q=pool[pos];
    const pct=pos/pool.length*100;
    panel.innerHTML=`
      <div class="quiz-wrap">
        <div class="quiz-meta">
          <div class="qm-prog"><div class="qm-fill" style="width:${pct}%"></div></div>
          <div class="qm-score">
            <span>${pos+1}/${pool.length}</span>
            <span>✓${right}</span>
            ${combo>=3?`<span class="qm-combo">🔥×${combo}</span>`:''}
          </div>
        </div>
        <div class="quiz-type">Pilihan Ganda — اختيار من متعدد</div>
        <div class="quiz-q">${esc(q.q)}</div>
        <div class="opts" id="opts">
          ${q.opts.map((o,i)=>`<button class="opt-btn" data-i="${i}">${esc(o)}</button>`).join('')}
        </div>
        <div class="quiz-fb" id="qfb"></div>
      </div>`;
    document.querySelectorAll(".opt-btn").forEach(b=>{
      b.onclick=function(){
        document.querySelectorAll(".opt-btn").forEach(x=>x.disabled=true);
        const good=+b.dataset.i===q.ans;
        document.querySelector(`.opt-btn[data-i="${q.ans}"]`).classList.add("correct");
        const fb=document.getElementById("qfb");
        if(good){
          right++; combo++; S.maxCombo=Math.max(S.maxCombo,combo);
          const pts=10+(combo>=3?5:0); earned+=pts; gainXP(pts);
          b.classList.add("correct");
          fb.className="quiz-fb ok";
          fb.innerHTML=`✅ أحسنتَ! +${pts} XP${combo>=3?" — سلسلة 🔥":""}<br><small style="font-weight:400;color:var(--green)">${esc(q.ex)}</small>`;
        } else {
          combo=0; b.classList.add("wrong");
          fb.className="quiz-fb no";
          fb.innerHTML=`❌ الجواب: ${esc(q.opts[q.ans])}<br><small style="font-weight:400;color:var(--red)">${esc(q.ex)}</small>`;
        }
        setTimeout(()=>{ pos++; ask(); }, good?1200:2400);
      };
    });
  }

  function done() {
    const pct=Math.round(right/pool.length*100);
    const key=ch.id; const old=S.best[key]||0; const oldS=starsOf(key);
    if(pct>old){ S.best[key]=pct; saveState(); }
    const ns=starsOf(key), bonus=(ns-oldS)*25;
    if(bonus>0) gainXP(bonus);
    checkBadges();
    const stars=[0,1,2].map(i=>`<span class="result-star${i<(pct>=100?3:pct>=75?2:pct>=50?1:0)?' on':''}">⭐</span>`).join('');
    panel.innerHTML=`
      <div class="result-wrap">
        <div class="result-stars">${stars}</div>
        <div class="result-score">${right}/${pool.length}</div>
        <div class="result-sub">${pct}% Benar</div>
        <div class="result-xp">+${earned+Math.max(0,bonus)} XP${bonus>0?" · Bintang baru! ⭐":""}</div>
        <div class="result-msg">${pct===100?"ممتاز! حققتَ الدرجة الكاملة 🏆":pct>=75?"جيد جداً — تبقَّى خطوة صغيرة":"راجع المادة ثم حاول مرةً أخرى 📖"}</div>
        <div class="result-actions">
          <button class="r-btn primary" id="rAgain">↺ Coba lagi</button>
          <button class="r-btn" id="rCard">🃏 Flashcard</button>
          <button class="r-btn" id="rHome">🏠 Beranda</button>
        </div>
      </div>`;
    document.getElementById("rAgain").onclick=()=>renderQuiz(panel,ch);
    document.getElementById("rCard").onclick=()=>go({screen:"chapter",id:ch.id,tab:"flash"});
    document.getElementById("rHome").onclick=()=>go({screen:"home"});
  }
  ask();
}

/* ── Review ── */
function renderReview(panel, ch) {
  panel.innerHTML=`
    <div class="review-search"><input id="rsearch" type="search" placeholder="ابحث في المصطلحات… بحث" autocomplete="off"></div>
    <div style="margin-bottom:14px">
      <div class="section-title">المحاور الرئيسية — Pokok Materi</div>
      <div class="intro-topics">${ch.topics.map(t=>`<div class="intro-topic"><span class="it-dot"></span>${esc(t)}</div>`).join('')}</div>
    </div>
    <div class="section-title">المصطلحات — Kosakata Istilah</div>
    <div class="review-list" id="rlist"></div>`;

  function renderList(q) {
    const list=document.getElementById("rlist");
    const filtered=ch.cards.filter(c=>!q||c.term.includes(q)||c.def.includes(q));
    if(!filtered.length){ list.innerHTML='<div class="empty" style="grid-column:1/-1"><p>لا توجد نتائج.</p></div>'; return; }
    list.innerHTML=filtered.map((c,i)=>{
      const isK=!!S.known[ch.id+"-"+i];
      return `<div class="review-card${isK?' known':''}">
        <div class="rc-term">${esc(c.term)}</div>
        <div class="rc-def">${esc(c.def)}</div>
        ${c.ex?`<div class="rc-ex">📝 ${esc(c.ex)}</div>`:''}
        <span class="rc-tag">Bab ${ch.id}</span>
      </div>`;
    }).join('');
  }
  renderList('');
  document.getElementById("rsearch").oninput=function(){ renderList(this.value.trim()); };
}

/* ── Badges overlay ── */
function openBadges() {
  const {r,nx}=rankOf(S.xp);
  const pct=nx?Math.round((S.xp-r[0])/(nx[0]-r[0])*100):100;
  const box=document.getElementById("badgesBox");
  box.innerHTML=`
    <div class="overlay-head">
      <h2>🏅 الأوسمة والألقاب</h2>
      <button class="close-btn" id="closeOverlay">✕</button>
    </div>
    <div class="rank-strip">
      <div>
        <div class="rs-rank">${r[1]}</div>
        <div class="rs-sub">${S.xp} XP${nx?` · Menuju ${nx[1]}: ${nx[0]} XP`:' — Level Tertinggi!'}</div>
      </div>
      <div style="flex:1;height:6px;background:var(--surface2);border-radius:99px;overflow:hidden;margin:0 12px">
        <div style="height:100%;width:${pct}%;background:var(--accent);border-radius:99px;transition:width .6s"></div>
      </div>
      <div style="font-size:13px;font-weight:700;color:var(--accent)">${pct}%</div>
    </div>
    <div class="section-title">الأوسمة</div>
    <div class="badges-grid">
      ${BADGES.map(b=>`<div class="badge-item${S.badges[b.id]?' earned':''}">
        <span class="bi-icon">${b.icon}</span>
        <div class="bi-name">${b.name}</div>
        <div class="bi-desc">${b.desc}</div>
      </div>`).join('')}
    </div>
    <div class="section-title" style="margin-top:20px">الألقاب</div>
    <div class="badges-grid">
      ${RANKS.map(rk=>`<div class="badge-item${S.xp>=rk[0]?' earned':''}">
        <span class="bi-icon">📜</span>
        <div class="bi-name">${rk[1]}</div>
        <div class="bi-desc">${rk[0]} XP</div>
      </div>`).join('')}
    </div>`;
  document.getElementById("closeOverlay").onclick=closeBadges;
  document.getElementById("badgesOverlay").classList.add("open");
}
function closeBadges() { document.getElementById("badgesOverlay").classList.remove("open"); }
document.getElementById("badgesOverlay").onclick=function(e){ if(e.target===this) closeBadges(); };

/* ── Theme ── */
function toggleTheme() {
  const r=document.documentElement;
  const dark = r.dataset.theme ? r.dataset.theme==="dark" : matchMedia("(prefers-color-scheme:dark)").matches;
  r.dataset.theme = dark?"light":"dark";
  try{localStorage.setItem("nahwu-theme",r.dataset.theme);}catch{}
  renderTopbar();
}
try{ const t=localStorage.getItem("nahwu-theme"); if(t) document.documentElement.dataset.theme=t; }catch{}

/* ── Boot ── */
const appEl = document.getElementById("app");
const mainDiv = document.createElement("div");
mainDiv.id="main-content";
appEl.appendChild(mainDiv);
render();
</script>
